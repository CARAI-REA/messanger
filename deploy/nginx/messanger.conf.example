# Example nginx edge for messanger (TLS termination).
# Replace messanger.example, cert paths, and upstream addresses.
#
# Public surface:
#   HTTPS /api/v1/*  -> Envoy grpc-json transcoder :8080
#   WSS  /v1/ws      -> gateway :8082
#
# Do NOT expose user/auth/chat/media/search/notify gRPC ports publicly.
# ValidateCredentials must never appear in Envoy public HTTP routes.

upstream messanger_envoy {
    server 127.0.0.1:8080;
    keepalive 64;
}

upstream messanger_gateway {
    server 127.0.0.1:8082;
    keepalive 64;
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 443 ssl http2;
    server_name messanger.example;

    ssl_certificate     /etc/nginx/certs/messanger.example/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/messanger.example/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    client_max_body_size 64m;

    location /api/ {
        proxy_pass http://messanger_envoy;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    location /v1/ws {
        proxy_pass http://messanger_gateway/v1/ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Never expose Prometheus metrics on the public vhost.
    location /metrics {
        deny all;
        return 404;
    }
}

# Optional internal metrics vhost (VPN / office IP only)
server {
    listen 8443 ssl http2;
    server_name metrics.messanger.internal;

    ssl_certificate     /etc/nginx/certs/messanger.example/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/messanger.example/privkey.pem;

    allow 10.0.0.0/8;
    allow 192.168.0.0/16;
    deny all;

    location /user/metrics { proxy_pass http://127.0.0.1:9101/metrics; }
    location /auth/metrics { proxy_pass http://127.0.0.1:9102/metrics; }
    location /chat/metrics { proxy_pass http://127.0.0.1:9103/metrics; }
    location /gateway/metrics { proxy_pass http://127.0.0.1:9104/metrics; }
    location /media/metrics { proxy_pass http://127.0.0.1:9105/metrics; }
    location /search/metrics { proxy_pass http://127.0.0.1:9106/metrics; }
    location /notify/metrics { proxy_pass http://127.0.0.1:9107/metrics; }
}
