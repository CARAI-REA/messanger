FROM golang:1.25-alpine AS builder
WORKDIR /src
RUN apk add --no-cache ca-certificates
COPY platform ./platform
COPY shared ./shared
COPY notify ./notify
WORKDIR /src/notify
RUN CGO_ENABLED=0 go build -mod=vendor -o /out/notify ./cmd

FROM alpine:3.20
RUN apk add --no-cache ca-certificates
WORKDIR /app
COPY --from=builder /out/notify /app/bin/notify
COPY notify/internal/migrations /app/internal/migrations
ENV MIGRATION_DIRECTORY=/app/internal/migrations
EXPOSE 50055 9107
ENTRYPOINT ["/app/bin/notify"]
