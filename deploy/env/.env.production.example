# Production environment example — copy to a secret store / sealed-secrets.
# Never commit real values. APP_ENV=production refuses weak/dev defaults.

APP_ENV=production

# Strong random secrets (>=32 bytes). Rotate independently.
JWT_SECRET=REPLACE_WITH_STRONG_ACCESS_JWT_SECRET
REFRESH_TOKEN_SECRET=REPLACE_WITH_STRONG_REFRESH_JWT_SECRET
SERVICE_JWT_SECRET=REPLACE_WITH_STRONG_SERVICE_JWT_SECRET
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

# Managed infra endpoints (no localhost)
CORE_KAFKA_BROKERS=kafka.prod.example:9092
CORE_REDIS_HOST=redis.prod.example
CORE_REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD
CORE_OPENSEARCH_URL=https://opensearch.prod.example:9200
CORE_S3_ENDPOINT=https://s3.prod.example
CORE_S3_ACCESS_KEY=REPLACE_ME
CORE_S3_SECRET_KEY=REPLACE_ME
CORE_S3_BUCKET=messanger-media
CORE_S3_REGION=eu-central-1
CORE_S3_USE_PATH_STYLE=false

# Postgres (managed) — SSL required
USER_APP_ENV=production
USER_POSTGRES_HOST=pg-user.prod.example
USER_POSTGRES_PORT=5432
USER_POSTGRES_USER=user_user
USER_POSTGRES_PASSWORD=REPLACE_ME
USER_POSTGRES_DB=users
USER_POSTGRES_SSL_MODE=require
USER_JWT_SECRET=${JWT_SECRET}
USER_SERVICE_JWT_SECRET=${SERVICE_JWT_SECRET}
USER_KAFKA_BROKERS=${CORE_KAFKA_BROKERS}
USER_GRPC_HOST=0.0.0.0
USER_GRPC_PORT=50051
USER_METRICS_HOST=127.0.0.1
USER_METRICS_PORT=9101

AUTH_APP_ENV=production
AUTH_REDIS_HOST=${CORE_REDIS_HOST}
AUTH_REDIS_PORT=6379
AUTH_REDIS_PASSWORD=${CORE_REDIS_PASSWORD}
AUTH_USER_GRPC_ADDRESS=user:50051
AUTH_USER_GRPC_TLS=true
AUTH_JWT_SECRET=${JWT_SECRET}
AUTH_REFRESH_TOKEN_SECRET=${REFRESH_TOKEN_SECRET}
AUTH_SERVICE_JWT_SECRET=${SERVICE_JWT_SECRET}
AUTH_ACCESS_TOKEN_TTL=${ACCESS_TOKEN_TTL}
AUTH_REFRESH_TOKEN_TTL=${REFRESH_TOKEN_TTL}
AUTH_GRPC_HOST=0.0.0.0
AUTH_GRPC_PORT=50050
AUTH_METRICS_HOST=127.0.0.1
AUTH_METRICS_PORT=9102
AUTH_GRPC_MAX_RPS=50
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_ATTEMPTS_WINDOW=15m

CHAT_APP_ENV=production
CHAT_POSTGRES_HOST=pg-chat.prod.example
CHAT_POSTGRES_PORT=5432
CHAT_POSTGRES_USER=chat_user
CHAT_POSTGRES_PASSWORD=REPLACE_ME
CHAT_POSTGRES_DB=chats
CHAT_POSTGRES_SSL_MODE=require
CHAT_REDIS_HOST=${CORE_REDIS_HOST}
CHAT_REDIS_PORT=6379
CHAT_REDIS_PASSWORD=${CORE_REDIS_PASSWORD}
CHAT_JWT_SECRET=${JWT_SECRET}
CHAT_SERVICE_JWT_SECRET=${SERVICE_JWT_SECRET}
CHAT_KAFKA_BROKERS=${CORE_KAFKA_BROKERS}
CHAT_GRPC_HOST=0.0.0.0
CHAT_GRPC_PORT=50052
CHAT_METRICS_HOST=127.0.0.1
CHAT_METRICS_PORT=9103
CHAT_REALTIME_CHANNEL=chat:realtime

GATEWAY_APP_ENV=production
GATEWAY_HTTP_HOST=0.0.0.0
GATEWAY_HTTP_PORT=8082
GATEWAY_REDIS_HOST=${CORE_REDIS_HOST}
GATEWAY_REDIS_PORT=6379
GATEWAY_REDIS_PASSWORD=${CORE_REDIS_PASSWORD}
GATEWAY_JWT_SECRET=${JWT_SECRET}
GATEWAY_SERVICE_JWT_SECRET=${SERVICE_JWT_SECRET}
GATEWAY_WS_ALLOWED_ORIGINS=https://app.example.com
GATEWAY_CHAT_GRPC_ADDRESS=chat:50052
GATEWAY_CHAT_GRPC_TLS=true
GATEWAY_METRICS_HOST=127.0.0.1
GATEWAY_METRICS_PORT=9104
GATEWAY_MAX_WS_CONNECTIONS=50000
GATEWAY_MAX_MSG_PER_SEC=20
GATEWAY_DRAIN_SECONDS=25
GATEWAY_ALLOW_QUERY_TOKEN=false

MEDIA_APP_ENV=production
MEDIA_POSTGRES_HOST=pg-media.prod.example
MEDIA_POSTGRES_PORT=5432
MEDIA_POSTGRES_USER=media_user
MEDIA_POSTGRES_PASSWORD=REPLACE_ME
MEDIA_POSTGRES_DB=media
MEDIA_POSTGRES_SSL_MODE=require
MEDIA_JWT_SECRET=${JWT_SECRET}
MEDIA_SERVICE_JWT_SECRET=${SERVICE_JWT_SECRET}
MEDIA_S3_ENDPOINT=${CORE_S3_ENDPOINT}
MEDIA_S3_ACCESS_KEY=${CORE_S3_ACCESS_KEY}
MEDIA_S3_SECRET_KEY=${CORE_S3_SECRET_KEY}
MEDIA_S3_BUCKET=${CORE_S3_BUCKET}
MEDIA_S3_REGION=${CORE_S3_REGION}
MEDIA_S3_USE_PATH_STYLE=${CORE_S3_USE_PATH_STYLE}
MEDIA_MAX_UPLOAD_BYTES=52428800
MEDIA_ALLOWED_MIME_PREFIXES=image/,video/,audio/,application/pdf

SEARCH_APP_ENV=production
SEARCH_JWT_SECRET=${JWT_SECRET}
SEARCH_SERVICE_JWT_SECRET=${SERVICE_JWT_SECRET}
SEARCH_KAFKA_BROKERS=${CORE_KAFKA_BROKERS}
SEARCH_OPENSEARCH_URL=${CORE_OPENSEARCH_URL}
SEARCH_OPENSEARCH_USERNAME=REPLACE_ME
SEARCH_OPENSEARCH_PASSWORD=REPLACE_ME

NOTIFY_APP_ENV=production
NOTIFY_POSTGRES_HOST=pg-notify.prod.example
NOTIFY_POSTGRES_PORT=5432
NOTIFY_POSTGRES_USER=notify_user
NOTIFY_POSTGRES_PASSWORD=REPLACE_ME
NOTIFY_POSTGRES_DB=notify
NOTIFY_POSTGRES_SSL_MODE=require
NOTIFY_REDIS_HOST=${CORE_REDIS_HOST}
NOTIFY_REDIS_PORT=6379
NOTIFY_REDIS_PASSWORD=${CORE_REDIS_PASSWORD}
NOTIFY_JWT_SECRET=${JWT_SECRET}
NOTIFY_SERVICE_JWT_SECRET=${SERVICE_JWT_SECRET}
NOTIFY_KAFKA_BROKERS=${CORE_KAFKA_BROKERS}
NOTIFY_PUSH_PROVIDER=fcm
NOTIFY_FCM_CREDENTIALS_FILE=/secrets/fcm.json
